5 PRINT CHR$(147): REM CLEAN SCREEN
10 REM C64 + THREE 1541 MONTE CARLO BENCHMARK
20 REM TRUE DRIVE BACKGROUND VIA U3 + JOB QUEUE
30 REM DRIVE COMMON {DRIVE_COMMON_HEX}, TABLE {DRIVE_TABLE_HEX}, U3/U4 {DRIVE_UCMD_HEX}
40 REM DRIVE PARAMS {DRIVE_PARAMS_HEX}, JOBS {DRIVE_JOBS_HEX}
50 REM C64 ASM {C64_LOAD_HEX}, PARAMS {C64_PARAMS_HEX}, TABLE {C64_TABLE_HEX}
51 REM DRIVE IMAGE LOAD={DRIVE_LOAD_HEX} LEN={DRIVE_LEN}
52 REM C64 IMAGE LOAD={C64_LOAD_HEX} LEN={C64_LEN}

60 DIM Q(255)
70 GOSUB 1000
80 GOSUB 1100

90 PRINT "UPL ASM WORKERS: C64...";
100 GOSUB 7500
110 GOSUB 7650

120 PRINT "DRV 8...";
130 D=8:GOSUB 2000
140 PRINT "9...";
150 D=9:GOSUB 2000
160 PRINT "10..."
170 D=10:GOSUB 2000

180 PRINT
190 TW={TOTAL_WORK}
200 JY=50
205 PW=0
206 CW={C64_WEIGHT}:DW={DRIVE_WEIGHT}
210 PRINT "TOTAL WORK PER TEST =";TW
220 PRINT "DRIVE JOB CHUNK = {DRIVE_CHUNK}"
225 PRINT "WEIGHTS C64=";CW;" DRIVE=";DW
230 PRINT

240 PRINT "MODE 1: C64 ONLY"
250 MD=1:GOSUB 8000:T1=TM
260 PRINT
270 PRINT "MODE 2: C64 + DRIVE 8"
280 MD=2:GOSUB 8000:T2=TM
290 PRINT
300 PRINT "MODE 3: C64 + DRIVE 8 + DRIVE 9"
310 MD=3:GOSUB 8000:T3=TM
320 PRINT
330 PRINT "MODE 4: C64 + DRIVE 8 + DRIVE 9 + DRIVE 10"
340 MD=4:GOSUB 8000:T4=TM
350 PRINT
360 PRINT "MODE 5: DRIVES ONLY (8+9+10)"
370 MD=5:GOSUB 8000:T5=TM

380 PRINT
390 PRINT "BENCHMARK SUMMARY"
400 PRINT "C64 ONLY        ";INT(T1*100+0.5)/100;" SEC"
410 PRINT "C64 + DRV8      ";INT(T2*100+0.5)/100;" SEC"
420 PRINT "C64 + DRV8+9    ";INT(T3*100+0.5)/100;" SEC"
430 PRINT "C64 + DRV8+9+10 ";INT(T4*100+0.5)/100;" SEC"
440 PRINT "DRIVES ONLY     ";INT(T5*100+0.5)/100;" SEC"
450 PRINT
460 IF T2<>0 THEN PRINT "SPEEDUP 2 =";INT(T1/T2*100+0.5)/100
470 IF T3<>0 THEN PRINT "SPEEDUP 3 =";INT(T1/T3*100+0.5)/100
480 IF T4<>0 THEN PRINT "SPEEDUP 4 =";INT(T1/T4*100+0.5)/100
485 REM SCALING EFFICIENCY, IDEAL N=1
490 IF T2<>0 THEN PRINT "EFF 2     =";INT(T1/T2/2*100+0.5)/100
500 IF T3<>0 THEN PRINT "EFF 3     =";INT(T1/T3/3*100+0.5)/100
510 IF T4<>0 THEN PRINT "EFF 4     =";INT(T1/T4/4*100+0.5)/100
520 GOSUB 1200
530 END

1000 REM BUILD TABLE
1010 PRINT "BUILDING TABLE..."
1020 FOR X=0 TO 255
1030 Q(X)=INT(SQR(65536-X*X))
1040 IF Q(X)>255 THEN Q(X)=255
1050 NEXT X
1060 RETURN

1100 REM OPEN ALL DRIVE COMMAND CHANNELS
1110 OPEN 8,8,15
1120 OPEN 9,9,15
1130 OPEN 10,10,15
1140 RETURN

1200 REM RESET DRIVERS AND CLOSE ALL DRIVE COMMAND CHANNELS 
1210 PRINT#8, "U4"
1220 PRINT#8, "I0"
1230 PRINT#9, "U4"
1240 PRINT#9, "I0"
1250 PRINT#10, "U4"
1260 PRINT#10, "I0"
1270 REM PRINT#8, "UJ":REM HANGS VICE AND DENISE EMU
1280 REM PRINT#9, "UJ"
1290 REM PRINT#10,"UJ"
1300 CLOSE 8
1310 CLOSE 9
1320 CLOSE 10
1340 RETURN

2000 REM UPLOAD DRIVE WORKER IMAGE TO DRIVE D
2001 REM LITTLE BIT UNOPTIMAL, TABLE ($0400) AND SOME OTHER CAN BE SKIPPED
2010 RESTORE
2020 A={DRIVE_LOAD}
2030 LN={DRIVE_LEN}
2040 P=0
2050 IF P>=LN THEN 2180
2055 REM BATCH SIZE FOR UPLOAD. THE MORE THE BETTER, WITHIN LIMIT
2060 C=32: REM 16 COULD BE SAFER VALUE 34 LOOK LIKE ABS MAX
2070 IF LN-P<C THEN C=LN-P
2080 AD=A+P
2090 LO=AD-256*INT(AD/256)
2100 HI=INT(AD/256)
2110 A$="M-W"+CHR$(LO)+CHR$(HI)+CHR$(C)
2120 FOR J=1 TO C
2130 READ B
2140 A$=A$+CHR$(B)
2150 NEXT J
2160 PRINT#D,A$
2170 P=P+C:GOTO 2050
2180 GOSUB 3000
2190 RETURN

3000 REM UPLOAD THRESHOLD TABLE TO DRIVE ADDR {DRIVE_TABLE_HEX}
3010 FOR BL=0 TO 7
3020 A={DRIVE_TABLE_DEC}+BL*32
3030 LO=A-256*INT(A/256)
3040 HI=INT(A/256)
3050 A$="M-W"+CHR$(LO)+CHR$(HI)+CHR$(32)
3055 REM LIMIT: 34
3060 FOR I=0 TO 31
3070 A$=A$+CHR$(Q(BL*32+I))
3080 NEXT I
3090 PRINT#D,A$
3100 NEXT BL
3110 RETURN

4000 REM SET DRIVE PARAMS AT {DRIVE_PARAMS_HEX}
4010 NL=N-256*INT(N/256)
4020 NH=INT(N/256)
4025 REM HARDCODED VALUE -- BE CAREFUL
4030 A$="M-W"+CHR$(208)+CHR$(5)+CHR$(7)
4040 A$=A$+CHR$(NL)+CHR$(NH)+CHR$(AL)
4050 A$=A$+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(AH)
4060 PRINT#D,A$
4070 RETURN

5000 REM START DRIVE BACKGROUND WORKER WITH U3
5010 PRINT#D,"U3"
5020 RETURN

5500 REM STOP WORKER AND FORCE LED OFF
5510 PRINT#D,"U4"
5520 PRINT#D,"M-R"+CHR$({DRIVE_VIA_PRB_LO})+CHR$({DRIVE_VIA_PRB_HI})
5530 A$=""
5540 GET#D,A$
5550 V=0
5560 IF A$<>"" THEN V=ASC(A$)
5570 V=V OR {DRIVE_LED_BIT}
5580 PRINT#D,"M-W"+CHR$({DRIVE_VIA_PRB_LO})+CHR$({DRIVE_VIA_PRB_HI})+CHR$(1)+CHR$(V)
5590 RETURN

6000 REM READ STATUS FROM $05D3 INTO SV
6010 PRINT#D,"M-R"+CHR$(211)+CHR$(5)
6020 A$=""
6030 GET#D,A$
6040 SV=0
6050 IF A$<>"" THEN SV=ASC(A$)
6060 RETURN

6100 REM READ RESULT FROM $05D4/$05D5 INTO RV
6110 PRINT#D,"M-R"+CHR$(212)+CHR$(5)
6120 L$=""
6130 GET#D,L$
6140 LB=0
6150 IF L$<>"" THEN LB=ASC(L$)
6160 PRINT#D,"M-R"+CHR$(213)+CHR$(5)
6170 H$=""
6180 GET#D,H$
6190 HB=0
6200 IF H$<>"" THEN HB=ASC(H$)
6210 RV=LB+256*HB
6220 RETURN

7500 REM UPLOAD C64 ASM WORKER TO ADDR {C64_LOAD_HEX}
7510 RESTORE
7520 FOR Z=1 TO {DRIVE_LEN}
7530 READ B
7540 NEXT Z
7550 A={C64_LOAD}
7560 FOR II=1 TO {C64_LEN}
7570 READ B
7580 POKE A,B
7590 A=A+1
7600 NEXT II
7610 RETURN

7650 REM COPY TABLE Q() TO C64 ASM TABLE {C64_TABLE_HEX}
7660 FOR II=0 TO 255
7670 POKE {C64_TABLE_DEC}+II,Q(II)
7680 NEXT II
7690 RETURN

7700 REM RUN C64 ASM WORKER
7710 NL=N-256*INT(N/256)
7720 NH=INT(N/256)
7730 POKE {C64_ITERLO_DEC},NL
7740 POKE {C64_ITERHI_DEC},NH
7750 POKE {C64_SEEDLO_DEC},AL
7760 POKE {C64_STATUS_DEC},0
7770 POKE {C64_INLO_DEC},0
7780 POKE {C64_INHI_DEC},0
7790 POKE {C64_SEEDHI_DEC},AH
7800 SYS {C64_LOAD}
7810 LC=PEEK({C64_INLO_DEC})+256*PEEK({C64_INHI_DEC})
7820 RETURN

8000 REM RUN BENCHMARK MODE
8010 NC=0:N8=0:N9=0:NA=0
8020 IF MD=1 THEN NC=TW:GOTO 8080

8030 IF MD=2 THEN W=CW+DW:NC=INT(TW*CW/W):N8=TW-NC:GOTO 8080
8040 IF MD=3 THEN W=CW+2*DW:NC=INT(TW*CW/W):R=TW-NC
8041 IF MD=3 THEN N8=INT(R/2):N9=R-N8
8042 IF MD=3 THEN GOTO 8080

8050 IF MD=4 THEN W=CW+3*DW:NC=INT(TW*CW/W):R=TW-NC
8051 IF MD=4 THEN N8=INT(R/3):N9=N8
8052 IF MD=4 THEN NA=R-N8-N9:GOTO 8080

8060 IF MD=5 THEN R=TW:N8=INT(R/3):N9=N8:NA=R-N8-N9

8080 LC=0:B8=0:B9=0:BA=0
8090 PRINT "WORK C64=";MID$(STR$(NC),2);" D8=";MID$(STR$(N8),2);
8095 PRINT " D9=";MID$(STR$(N9),2);" D10=";MID$(STR$(NA),2)
8100 S8=2:S9=2:SA=2:X8=0:X9=0:XA=0
8110 J0=TI

8120 IF N8<=0 THEN 8170
8130 X8=1:S8=0:N=N8
8140 AL={DRIVE8_SEED_LO_DEC}:AH={DRIVE8_SEED_HI_DEC}:D=8:GOSUB 4000:D=8:GOSUB 5000
8150 PRINT "AFTER D8 START T=";MID$(STR$((TI-J0)/JY),2)

8170 IF N9<=0 THEN 8240
8180 X9=1:S9=0:N=N9
8190 AL={DRIVE9_SEED_LO_DEC}:AH={DRIVE9_SEED_HI_DEC}:D=9:GOSUB 4000:D=9:GOSUB 5000
8200 PRINT "AFTER D9 START T=";MID$(STR$((TI-J0)/JY),2)

8240 IF NA<=0 THEN 8340
8250 XA=1:SA=0:N=NA
8260 AL={DRIVE10_SEED_LO_DEC}:AH={DRIVE10_SEED_HI_DEC}:D=10:GOSUB 4000:D=10:GOSUB 5000
8270 PRINT "AFTER D10 START T=";MID$(STR$((TI-J0)/JY),2)

8340 IF NC<=0 THEN 8380
8350 N=NC:AL={C64_SEED_LO_DEC}:AH={C64_SEED_HI_DEC}:GOSUB 7700
8360 PRINT "AFTER C64 T=";MID$(STR$((TI-J0)/JY),2)

8364 REM UNCOMMENT ALL TO USE 
8365 REM IF X8=1 THEN D=8:GOSUB 6000:PRINT "D8 STAT AFTER C64=";MID$(STR$(SV),2)
8366 REM IF X8=1 THEN D=8:GOSUB 6100
8367 REM IF X8=1 THEN PRINT "D8 RES AFTER C64=";RV

8368 REM IF X9=1 THEN D=9:GOSUB 6000:PRINT "D9 STAT AFTER C64=";SV
8369 REM IF X9=1 THEN D=9:GOSUB 6100
8370 REM IF X9=1 THEN PRINT "D9 RES AFTER C64=";RV

8371 REM IF XA=1 THEN D=10:GOSUB 6000:PRINT "D10 STAT AFTER C64=";SV
8372 REM IF XA=1 THEN D=10:GOSUB 6100
8373 REM IF XA=1 THEN PRINT "D10 RES AFTER C64=";RV

8375 PRINT "C64 =";LC

8380 IF N8+N9+NA=0 THEN 8600

8400 IF S8=2 AND S9=2 AND SA=2 THEN 8500
8410 TQ=TI
8420 IF TI-TQ<PW THEN 8420
8430 PX=PX+1
8440 IF PX>3 THEN PX=1
8450 IF PX=1 AND X8=1 AND S8<>2 THEN D=8:GOSUB 6000:S8=SV:GOTO 8400
8460 IF PX=2 AND X9=1 AND S9<>2 THEN D=9:GOSUB 6000:S9=SV:GOTO 8400
8470 IF PX=3 AND XA=1 AND SA<>2 THEN D=10:GOSUB 6000:SA=SV:GOTO 8400
8480 GOTO 8400

8500 IF X8=1 THEN D=8:GOSUB 6100:B8=RV:PRINT "DRV8=";MID$(STR$(B8),2)
8510 IF X9=1 THEN D=9:GOSUB 6100:B9=RV:PRINT "DRV9=";MID$(STR$(B9),2)
8520 IF XA=1 THEN D=10:GOSUB 6100:BA=RV:PRINT "DRV10=";MID$(STR$(BA),2)
8530 IF X8=1 THEN D=8:GOSUB 5500
8540 IF X9=1 THEN D=9:GOSUB 5500
8550 IF XA=1 THEN D=10:GOSUB 5500

8600 EJ=TI-J0
8610 IF EJ<0 THEN EJ=EJ+5184000
8620 TM=EJ/JY

8630 IC=LC+B8+B9+BA
8640 TT=TW
8690 P=4*IC/TT
8700 PRINT "RESULT PI=";P
8710 PRINT "TIME=";TM;" SEC"
8720 RETURN


8999 REM DRIVE DATA
{DRIVE_DATA}

11999 REM C64 DATA
{C64_DATA}
