2 POKE 55,0:POKE 56,64:CLR5 PRINT CHR$(147)10 REM MONTE CARLO PI MULTICOLOR BITMAP20 REM BITMAP $6000, SCREEN $5C00, BANK $400030 REM YELLOW CIRCLE, GREEN IN, RED OUT40 DIM F(15,4),YA(200),XA(159),PQ(159)45 DIM CM(3),CV(3,3),MP(90),TB(7),XL(70),YL(140)50 NT=100060 RX=35:RY=70:XC=80:YC=11265 RW=RX*2:RH=RY*2:X0=XC-RX:Y0=YC-RY70 LM=RX*RX*RY*RY80 IC=0:CT=090 PRINT "READING FONT..."100 GOSUB 850110 GOSUB 9000120 R=RND(-TI)130 PRINT "PREPARING BITMAP..."140 GOSUB 2000150 PRINT "DRAWING HUD..."160 GOSUB 3900170 I=0:GOSUB 600180 PRINT "DRAWING CIRCLE..."190 GOSUB 2500200 PRINT "ENTERING GRAPHICS..."210 GOSUB 2100220 FOR I=1 TO NT230 X=INT(RND(1)*RW)+X0240 Y=INT(RND(1)*RH)+Y0250 DX=X-XC:DY=Y-YC260 VL=XL(DX+RX)+YL(DY+RY)270 IF VL<=LM THEN IC=IC+1:PC=2:GOTO 290280 PC=3290 XP=X:YP=Y:GOSUB 500300 CT=CT+1310 IF CT=10 THEN GOSUB 600:CT=0320 NEXT I330 GOSUB 600340 GET K$:IF K$="" THEN 340350 GOSUB 5000360 END500 REM PLOT VISIBLE 1X2 POINT FAST510 Q=PQ(XP):XB=XA(XP):AD=YA(YP)+XB520 POKE AD,(PEEK(AD) AND CM(Q)) OR CV(PC,Q)530 AD=YA(YP+1)+XB540 POKE AD,(PEEK(AD) AND CM(Q)) OR CV(PC,Q)550 RETURN560 REM PLOT MULTICOLOR PIXEL FAST570 Q=PQ(XP):AD=YA(YP)+XA(XP)580 POKE AD,(PEEK(AD) AND CM(Q)) OR CV(PC,Q)590 RETURN600 REM UPDATE HUD NUMBERS ONLY610 IF I=0 THEN PT=0:GOTO 630620 PT=4*IC/I630 A$=STR$(I):B$=STR$(PT)640 S$=MID$(A$,2)+"     ":PY=0:BC=2:GOSUB 700650 S$=MID$(B$,2,6)+"     ":PY=10:BC=3:GOSUB 700660 RETURN700 REM DRAW STRING FAST710 BO=BC*8720 FOR J=1 TO LEN(S$)730 K=MP(ASC(MID$(S$,J,1)))740 GOSUB 760750 BO=BO+8:NEXT J755 RETURN760 REM DRAW ONE CHAR FAST770 B=F(K,0):AD=YA(PY)+BO:POKE AD,B:POKE AD+1,B780 B=F(K,1):AD=YA(PY+2)+BO:POKE AD,B:POKE AD+1,B790 B=F(K,2):AD=YA(PY+4)+BO:POKE AD,B:POKE AD+1,B800 B=F(K,3):AD=YA(PY+6)+BO:POKE AD,B:POKE AD+1,B810 B=F(K,4):AD=YA(PY+8)+BO:POKE AD,B:POKE AD+1,B820 RETURN850 REM INIT FAST TABLES860 TB(0)=0:TB(1)=4:TB(2)=16:TB(3)=20870 TB(4)=64:TB(5)=68:TB(6)=80:TB(7)=84880 FOR Q=0 TO 200:YA(Q)=24576+INT(Q/8)*320+(Q AND 7):NEXT Q890 FOR Q=0 TO 159:XA(Q)=INT(Q/4)*8:PQ(Q)=Q AND 3:NEXT Q900 CM(0)=63:CM(1)=207:CM(2)=243:CM(3)=252910 CV(1,0)=64:CV(1,1)=16:CV(1,2)=4:CV(1,3)=1920 CV(2,0)=128:CV(2,1)=32:CV(2,2)=8:CV(2,3)=2930 CV(3,0)=192:CV(3,1)=48:CV(3,2)=12:CV(3,3)=3940 MP(32)=0:MP(46)=5:MP(61)=4:MP(73)=3950 MP(78)=1:MP(80)=2960 FOR Q=48 TO 57:MP(Q)=Q-42:NEXT Q970 FOR Q=0 TO RW:D=Q-RX:XL(Q)=D*D*RY*RY:NEXT Q980 FOR Q=0 TO RH:D=Q-RY:YL(Q)=D*D*RX*RX:NEXT Q990 RETURN2000 REM PREPARE MEMORY BEFORE GRAPHICS2010 FOR A=24576 TO 32767:POKE A,0:NEXT A2020 FOR A=23552 TO 24551:POKE A,117:NEXT A2030 FOR A=55296 TO 56295:POKE A,2:NEXT A2040 RETURN2100 REM SETUP MULTICOLOR BITMAP BANK $40002110 POKE 56576,(PEEK(56576) AND 252) OR 22120 POKE 53280,62130 POKE 53281,02140 POKE 53265,PEEK(53265) OR 322150 POKE 53270,PEEK(53270) OR 162160 POKE 53272,1202170 RETURN2500 REM DRAW VISUAL CIRCLE AS ELLIPSE2510 PC=12520 FOR DX=-RX TO RX2530 YY=INT(RY*SQR(1-DX*DX/(RX*RX)))2540 XP=XC+DX:YP=YC+YY:GOSUB 5602550 XP=XC+DX:YP=YC-YY:GOSUB 5602560 NEXT DX2570 FOR DY=-RY TO RY2580 XX=INT(RX*SQR(1-DY*DY/(RY*RY)))2590 XP=XC+XX:YP=YC+DY:GOSUB 5602600 XP=XC-XX:YP=YC+DY:GOSUB 5602610 NEXT DY2620 RETURN3900 REM DRAW STATIC HUD LABELS3910 S$="N=":PY=0:BC=0:GOSUB 7003920 S$="PI=":PY=10:BC=0:GOSUB 7003930 RETURN5000 REM EXIT TO TEXT5010 POKE 53265,PEEK(53265) AND 2235020 POKE 53270,PEEK(53270) AND 2395030 POKE 53272,215040 POKE 56576,(PEEK(56576) AND 252) OR 35050 PRINT CHR$(147)5060 PT=4*IC/NT5070 PRINT "MONTE CARLO MULTICOLOR"5080 PRINT "N=";NT5090 PRINT "INSIDE=";IC5100 PRINT "PI=";PT5110 RETURN9000 REM READ FONT DATA9010 FOR Z=0 TO 799020 READ FV9030 K=INT(Z/5):RR=Z-5*K9040 F(K,RR)=TB(FV)9050 NEXT Z9060 RETURN9100 REM 0 SPACE9110 DATA 0,0,0,0,09120 REM 1 N9130 DATA 5,7,7,7,59140 REM 2 P9150 DATA 6,5,6,4,49160 REM 3 I9170 DATA 7,2,2,2,79180 REM 4 =9190 DATA 0,7,0,7,09200 REM 5 .9210 DATA 0,0,0,0,29220 REM 6 DIGIT 09